{
  "SDKVersion": 2,
  "UUID": "com.fulgan.managedapplauncher",
  "Author": "Fulgan",
  "Name": "Managed App Launcher",
  "Description": "Launches applications from managed lists, with automatic paging on every deck, a running indicator and long press to close. Supports shortcuts, programs, versioned folders, Store apps and Steam games.",
  "Category": "Managed App Launcher",
  "CategoryIcon": "imgs/category",
  "Icon": "imgs/plugin",
  "Version": "1.0.0.0",
  "CodePath": "malaunch-plugin.exe",
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinimumVersion": "6.4"
  },
  "Actions": [
    {
      "UUID": "com.fulgan.managedapplauncher.open",
      "Name": "Open Launcher",
      "Icon": "imgs/action-open",
      "PropertyInspectorPath": "pi/open.html",
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key-open",
          "TitleAlignment": "bottom",
          "FontSize": 11
        }
      ]
    },
    {
      "UUID": "com.fulgan.managedapplauncher.manage",
      "Name": "Manage Apps",
      "Icon": "imgs/action-manage",
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key-manage",
          "TitleAlignment": "bottom",
          "FontSize": 11
        }
      ]
    },
    {
      "UUID": "com.fulgan.managedapplauncher.slot",
      "Name": "App Slot",
      "Icon": "imgs/action-slot",
      "Tooltip": "Used by the launcher profile; not needed on other profiles.",
      "PropertyInspectorPath": "pi/slot.html",
      "SupportedInMultiActions": true,
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key-slot",
          "TitleAlignment": "bottom",
          "FontSize": 11
        }
      ]
    },
    {
      "UUID": "com.fulgan.managedapplauncher.launch",
      "Name": "Launch App",
      "Icon": "imgs/action-launch",
      "PropertyInspectorPath": "pi/launch.html",
      "SupportedInMultiActions": true,
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key-launch",
          "TitleAlignment": "bottom",
          "FontSize": 11
        }
      ]
    }
  ]
}
