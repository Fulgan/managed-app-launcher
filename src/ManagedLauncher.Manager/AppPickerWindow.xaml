<Window x:Class="ManagedLauncher.Manager.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ManagedLauncher.Manager"
        Width="540" Height="640"
        Icon="app.ico" Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="16,8,16,14">
    <TextBlock DockPanel.Dock="Top" x:Name="HeadingText" Style="{StaticResource LargeTitle}" Margin="4,0,0,10" />
    <TextBox DockPanel.Dock="Top" x:Name="SearchBox" local:Hint.Text="Search" TextChanged="SearchBox_TextChanged" Margin="0,0,0,12" />
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="CountText" Style="{StaticResource Footnote}" VerticalAlignment="Center" Margin="4,0,0,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" IsCancel="True" Style="{StaticResource Plain}" />
        <Button Content="Add" IsDefault="True" Click="Add_Click" Style="{StaticResource Filled}" Padding="22,6" Margin="0" />
      </StackPanel>
    </DockPanel>
    <Border Style="{StaticResource Card}" Padding="0,6">
      <ListBox x:Name="AppsBox" SelectionMode="Extended" MouseDoubleClick="AppsBox_MouseDoubleClick"
               ItemContainerStyle="{StaticResource CardItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,12,0" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
