<Window x:Class="ManagedLauncher.Manager.IconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose icon" Width="600" Height="620"
        Icon="app.ico" Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <Style x:Key="Tile" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="3" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Width="76" Height="76" CornerRadius="12" Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Field}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Pressed}" />
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel Margin="16,8,16,14">
    <TextBlock DockPanel.Dock="Top" Text="Choose icon" Style="{StaticResource LargeTitle}" Margin="4,0,0,10" />
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
        <Button x:Name="AppButton" Content="App" Click="App_Click" />
        <Button x:Name="StockButton" Content="Stock" Click="Stock_Click" Visibility="Collapsed" />
        <Button x:Name="AppsButton" Content="Apps" Click="Apps_Click" Visibility="Collapsed" />
        <Button Content="Windows" Click="Windows_Click" />
        <Button Content="Browse…" Click="Browse_Click" Margin="0" />
      </StackPanel>
      <TextBlock x:Name="SourceText" Style="{StaticResource Footnote}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button x:Name="ResetButton" Content="Use app icon" Click="Reset_Click" Style="{StaticResource Plain}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" IsCancel="True" Style="{StaticResource Plain}" />
        <Button Content="Use icon" IsDefault="True" Click="Use_Click" Style="{StaticResource Filled}" Padding="22,6" Margin="0" />
      </StackPanel>
    </DockPanel>
    <Border Style="{StaticResource Card}" Padding="8">
      <Grid>
        <ListBox x:Name="IconsBox" ItemContainerStyle="{StaticResource Tile}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="IconsBox_MouseDoubleClick">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Image Source="{Binding Image}" Width="56" Height="56" ToolTip="{Binding Name}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText" Style="{StaticResource Footnote}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="This file holds no icons." Visibility="Collapsed" />
      </Grid>
    </Border>
  </DockPanel>
</Window>
