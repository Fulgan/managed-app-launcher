<Window x:Class="ManagedLauncher.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ManagedLauncher.Manager"
        Title="Managed App Launcher" Width="1180" Height="760" MinWidth="900" MinHeight="520"
        Icon="app.ico" Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid x:Name="Main" Margin="16,8,16,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="370" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Sidebar: lists -->
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10,12,10,10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Lists" Style="{StaticResource LargeTitle}" FontSize="22" Margin="6,0,0,10" />
          <StackPanel x:Name="DecksSection" DockPanel.Dock="Bottom" Margin="0,4,0,0"
                      ToolTip="A deck set to a list always shows that list">
            <TextBlock Text="DECKS" Style="{StaticResource SectionHeader}" Margin="6,14,6,4" />
            <StackPanel x:Name="DecksPanel" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource Icon}" Content="&#xE710;" Click="AddList_Click"
                    ToolTip="New list" AutomationProperties.Name="New list" Margin="6,0,0,0" />
            <Button Style="{StaticResource Icon}" Content="&#xE8C8;" Click="DuplicateList_Click"
                    ToolTip="Duplicate list" AutomationProperties.Name="Duplicate list" Margin="6,0,0,0" />
            <Button Style="{StaticResource Icon}" Content="&#xE738;" Click="RemoveList_Click"
                    ToolTip="Remove list" AutomationProperties.Name="Remove list" Margin="6,0,0,0" />
          </StackPanel>
          <ListBox x:Name="ListsBox" SelectionChanged="ListsBox_SelectionChanged" ItemContainerStyle="{StaticResource SidebarItem}"
                   MouseDoubleClick="ListsBox_MouseDoubleClick" KeyDown="ListsBox_KeyDown"
                   AllowDrop="True" DragOver="ListsBox_DragOver" DragLeave="ListsBox_DragLeave" Drop="ListsBox_Drop"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type local:ListRow}">
                <Grid MinHeight="22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="drop" Grid.ColumnSpan="3" Margin="-10,-7" CornerRadius="10" BorderThickness="2"
                          BorderBrush="{StaticResource Accent}" Visibility="Collapsed" />
                  <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Glyphs}" FontSize="14" Margin="0,1,10,0" VerticalAlignment="Center" />
                  <TextBlock x:Name="name" Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="14" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <Border x:Name="editor" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#40000000"
                          CornerRadius="6" BorderThickness="1.5" BorderBrush="#80FFFFFF" Margin="-4,-3" Padding="4,2"
                          ToolTip="{Binding Error}">
                    <TextBox Style="{StaticResource Inline}" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Foreground="White" CaretBrush="White" AutomationProperties.Name="List name"
                             IsVisibleChanged="ListName_IsVisibleChanged" TextChanged="ListName_TextChanged"
                             KeyDown="ListName_KeyDown" LostKeyboardFocus="ListName_LostKeyboardFocus" />
                  </Border>
                  <Button x:Name="pencil" Grid.Column="2" Content="&#xE70F;" FontFamily="{StaticResource Glyphs}" FontSize="12"
                          Foreground="White" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,2"
                          Margin="6,0,-4,0" Visibility="Collapsed" Click="RenameList_Click" Focusable="False"
                          ToolTip="Rename (F2)" AutomationProperties.Name="Rename list">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                          <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="pencil" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="name" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="pencil" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="editor" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="editor" Property="BorderBrush" Value="{StaticResource Error}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="drop" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Apps -->
      <DockPanel Grid.Column="2">
        <Grid DockPanel.Dock="Top" Margin="4,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="ListTitle" Style="{StaticResource LargeTitle}" />
            <TextBlock x:Name="PagesText" Style="{StaticResource Footnote}" Margin="0,2,0,0" />
            <CheckBox x:Name="ReturnAfterLaunchBox" Style="{StaticResource Switch}" Content="Return after launch" Margin="0,8,0,0"
                      HorizontalAlignment="Left" Checked="ReturnAfterLaunch_Changed" Unchecked="ReturnAfterLaunch_Changed"
                      ToolTip="After a launch, the deck returns to the previous profile, or to the first page" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button Style="{StaticResource Icon}" AutomationProperties.Name="Move up" Content="&#xE74A;" Click="Up_Click" ToolTip="Move up" Margin="0,0,6,0" />
            <Button Style="{StaticResource Icon}" AutomationProperties.Name="Move down" Content="&#xE74B;" Click="Down_Click" ToolTip="Move down" Margin="0,0,12,0" />
            <Button Content="Remove" Click="Remove_Click" x:Name="RemoveButton" Style="{StaticResource Destructive}" />
          </StackPanel>
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
          <Button Style="{StaticResource Filled}" Click="OpenMenu_Click" AutomationProperties.Name="Add app">
            <Button.ContextMenu>
              <ContextMenu Placement="Top">
                <MenuItem Header="From Start menu…" Click="AddStartMenu_Click" />
                <MenuItem Header="Running app…" Click="AddRunning_Click" />
                <MenuItem Header="File…" Click="AddFile_Click" />
                <MenuItem x:Name="SteamMenuItem" Header="Steam game…" Click="AddSteam_Click" />
              </ContextMenu>
            </Button.ContextMenu>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE710;" FontFamily="{StaticResource Glyphs}" FontSize="11" Margin="0,1,8,0" Foreground="White" VerticalAlignment="Center" />
              <TextBlock Text="Add app" Foreground="White" />
            </StackPanel>
          </Button>
          <Button Click="OpenMenu_Click" AutomationProperties.Name="Add separator">
            <Button.ContextMenu>
              <ContextMenu Placement="Top">
                <MenuItem Header="Row break" InputGestureText="next app on a new row" Click="AddRowBreak_Click" />
                <MenuItem Header="Page break" InputGestureText="next app on a new page" Click="AddPageBreak_Click" />
              </ContextMenu>
            </Button.ContextMenu>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE710;" FontFamily="{StaticResource Glyphs}" FontSize="11" Margin="0,1,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Add separator" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="0,6">
          <Grid>
            <ListBox x:Name="AppsBox" AllowDrop="True" SelectionMode="Single" ItemContainerStyle="{StaticResource CardItem}"
                     SelectionChanged="AppsBox_SelectionChanged" KeyDown="AppsBox_KeyDown"
                     PreviewMouseLeftButtonDown="AppsBox_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="AppsBox_PreviewMouseLeftButtonUp"
                     PreviewMouseMove="AppsBox_PreviewMouseMove"
                     DragOver="AppsBox_DragOver" DragLeave="AppsBox_DragLeave" Drop="AppsBox_Drop"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="26" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Foreground="{StaticResource Faint}" FontSize="12" VerticalAlignment="Center"
                               Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={x:Static local:IndexConverter.Instance}}" />
                    <Image Grid.Column="1" Source="{Binding Icon}" Width="44" Height="44">
                      <Image.Clip>
                        <RectangleGeometry Rect="0,0,44,44" RadiusX="10" RadiusY="10" />
                      </Image.Clip>
                    </Image>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="10" BorderThickness="1.5" BorderBrush="{StaticResource Faint}">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBreak}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding BreakGlyph}" FontFamily="{StaticResource Glyphs}" FontSize="18" Foreground="{StaticResource Muted}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Target}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,1,0,0" />
                      <TextBlock Text="{Binding Problem}" Foreground="{StaticResource Error}" FontSize="12" Margin="0,1,0,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasProblem}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Canvas IsHitTestVisible="False">
              <Border x:Name="DropLine" Height="3" CornerRadius="1.5" Background="{StaticResource Accent}" Visibility="Collapsed" />
            </Canvas>
          </Grid>
        </Border>
      </DockPanel>

      <!-- Details -->
      <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Details" IsEnabled="False" Margin="0,0,4,0">
          <Border x:Name="TestKey" HorizontalAlignment="Center" Margin="0,4,0,0" Background="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="TestKey_MouseLeftButtonDown" MouseLeftButtonUp="TestKey_MouseLeftButtonUp">
            <Image x:Name="PreviewImage" Width="96" Height="96">
              <Image.Clip>
                <RectangleGeometry Rect="0,0,96,96" RadiusX="22" RadiusY="22" />
              </Image.Clip>
            </Image>
          </Border>
          <TextBlock Text="{Binding SelectedItem.Name, ElementName=AppsBox}" FontSize="20" FontWeight="SemiBold"
                     FontFamily="{StaticResource TitleFont}" HorizontalAlignment="Center" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="click or hold the icon to test" Style="{StaticResource Footnote}" HorizontalAlignment="Center" Margin="0,2,0,0" />

          <TextBlock Text="KEY" Style="{StaticResource SectionHeader}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <TextBlock Text="Title" Style="{StaticResource RowLabel}" Width="100" />
                  <TextBox x:Name="TitleBox" Tag="title" Style="{StaticResource Inline}" local:Hint.Text="Stream Deck title"
                           LostFocus="Field_Changed" />
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <TextBlock Text="Target" Style="{StaticResource RowLabel}" Width="100" />
                  <Button DockPanel.Dock="Right" Style="{StaticResource Icon}" Content="&#xE8B7;" Click="BrowseTarget_Click"
                          Width="28" Height="28" Margin="8,0,0,0" ToolTip="Browse" AutomationProperties.Name="Browse" />
                  <TextBox x:Name="TargetBox" Tag="target" Style="{StaticResource Inline}" LostFocus="Field_Changed"
                           ToolTip=".lnk, exe, versioned path (app-*\x.exe) or AUMID" />
                </DockPanel>
              </Border>
              <Border Style="{StaticResource LastRow}">
                <DockPanel>
                  <TextBlock Text="Kind" Style="{StaticResource RowLabel}" Width="100" />
                  <ComboBox x:Name="KindBox" SelectionChanged="Combo_Changed" />
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>
          <TextBlock x:Name="ResolvedText" Style="{StaticResource Footnote}" Margin="16,6,16,0" />

          <TextBlock Text="BEHAVIOR" Style="{StaticResource SectionHeader}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <TextBlock Text="If running" Style="{StaticResource RowLabel}" Width="100" />
                  <ComboBox x:Name="OnRunningBox" SelectionChanged="Combo_Changed" />
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <TextBlock Text="Long press" Style="{StaticResource RowLabel}" Width="100" />
                  <ComboBox x:Name="LongPressBox" SelectionChanged="Combo_Changed" />
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <TextBlock Text="Kill" Style="{StaticResource RowLabel}" Width="100" />
                  <ComboBox x:Name="KillModeBox" SelectionChanged="Combo_Changed" />
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <TextBlock Text="Admin" Style="{StaticResource RowLabel}" Width="100" />
                  <ComboBox x:Name="AdminBox" SelectionChanged="Combo_Changed" />
                </DockPanel>
              </Border>
              <Border Style="{StaticResource LastRow}">
                <DockPanel>
                  <TextBlock Text="Indicator" Style="{StaticResource RowLabel}" Width="100" />
                  <ComboBox x:Name="IndicatorBox" SelectionChanged="Combo_Changed" />
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <TextBlock Text="ADVANCED" Style="{StaticResource SectionHeader}" />
          <Border Style="{StaticResource Card}" Margin="0,0,0,8">
            <StackPanel>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <TextBlock Text="Arguments" Style="{StaticResource RowLabel}" Width="100" />
                  <TextBox x:Name="ArgsBox" Tag="args" Style="{StaticResource Inline}" local:Hint.Text="none" LostFocus="Field_Changed" />
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <TextBlock Text="Start in" Style="{StaticResource RowLabel}" Width="100" />
                  <TextBox x:Name="WorkDirBox" Tag="workDir" Style="{StaticResource Inline}" local:Hint.Text="app folder" LostFocus="Field_Changed" />
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Row}">
                <DockPanel>
                  <TextBlock Text="Track exe" Style="{StaticResource RowLabel}" Width="100" />
                  <TextBox x:Name="TrackPathBox" Tag="trackPath" Style="{StaticResource Inline}" local:Hint.Text="same as target"
                           LostFocus="Field_Changed" ToolTip="Exe or folder\ whose processes count as the app" />
                </DockPanel>
              </Border>
              <Border Style="{StaticResource LastRow}">
                <DockPanel>
                  <TextBlock Text="Icon" Style="{StaticResource RowLabel}" Width="100" />
                  <Button DockPanel.Dock="Right" Style="{StaticResource Icon}" Content="&#xE8B9;" Click="PickIcon_Click"
                          Width="28" Height="28" Margin="8,0,0,0" ToolTip="Choose icon" AutomationProperties.Name="Choose icon" />
                  <TextBox x:Name="IconBox" Tag="icon" Style="{StaticResource Inline}" local:Hint.Text="app icon"
                           LostFocus="Field_Changed" />
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <TextBlock Grid.Row="1" Grid.ColumnSpan="5" x:Name="StatusText" Style="{StaticResource Footnote}" Margin="6,12,0,0" />
    </Grid>

    <!-- In-window alert: dims the window and takes all input until answered. -->
    <Grid x:Name="AlertLayer" Visibility="Collapsed" Background="#99000000" PreviewKeyDown="AlertLayer_PreviewKeyDown"
          KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
      <Border Width="300" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="14"
              Background="{StaticResource Field}" ClipToBounds="True">
        <StackPanel>
          <TextBlock x:Name="AlertTitle" FontFamily="{StaticResource TitleFont}" FontSize="17" FontWeight="SemiBold"
                     Foreground="{StaticResource Text}" TextAlignment="Center" TextWrapping="Wrap" Margin="18,20,18,0" />
          <TextBlock x:Name="AlertMessage" FontSize="13" Foreground="{StaticResource Muted}" TextAlignment="Center"
                     TextWrapping="Wrap" Margin="18,6,18,14" />
          <UniformGrid x:Name="AlertButtons" Margin="14,0,14,14" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
